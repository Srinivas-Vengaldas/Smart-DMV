# Postgres connection string used by Prisma (Neon or Supabase Postgres)
DATABASE_URL=
# Secret used to sign login session JWTs
JWT_SECRET=
# Supabase storage for uploaded documents
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Google Cloud Vision service-account JSON, on one line
GOOGLE_CREDENTIALS_JSON=
# Gemini API key for the staff review assistant
GEMINI_API_KEY=
